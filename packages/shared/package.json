{
  "name": "@patricktree/pi-vscode-terminal-notify.shared",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc --build ./tsconfig.json",
    "dev": "tsc --watch --build ./tsconfig.json",
